# Sanity — copy to .env.local and fill in.
# projectId + dataset are public (they ship in the browser bundle for /studio).
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-01-01"

# Write token — used ONLY by the seed script (scripts/seed.mjs). Keep it secret;
# do not prefix with NEXT_PUBLIC_. Create one in Sanity: API → Tokens (Editor).
SANITY_API_TOKEN=""
