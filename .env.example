# Sanity — copy to .env.local and fill in.
# projectId + dataset are public (they ship in the browser bundle for /studio).
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-01-01"

# Write token — used ONLY by the seed script (scripts/seed.mjs). Keep it secret;
# do not prefix with NEXT_PUBLIC_. Create one in Sanity: API → Tokens (Editor).
SANITY_API_TOKEN=""

# --- Contact form: email delivery (Resend) — server-only ---
# Create a key at resend.com and verify a sending domain for CONTACT_FROM.
# Enquiries are emailed to CONTACT_TO; nothing is logged. If these are unset the
# form still validates in dev but reports the email as not delivered.
RESEND_API_KEY=""
CONTACT_TO="hello@calibre-consulting.example"
CONTACT_FROM="Calibre website <enquiries@yourdomain.com>"

# --- Contact form: spam protection (Cloudflare Turnstile) ---
# Site key is public (reaches the browser); secret key is server-only. If unset,
# the human check is skipped in dev — the honeypot still runs.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Public contact details shown on the site (footer + contact section) ---
# Optional overrides; the app falls back to placeholders if unset.
NEXT_PUBLIC_CONTACT_EMAIL="hello@calibre-consulting.example"
NEXT_PUBLIC_CONTACT_PHONE="+91 00000 00000"
# E.164 (with +) for tel: links; digits-only derived for wa.me if the next is unset.
NEXT_PUBLIC_CONTACT_PHONE_TEL="+910000000000"
NEXT_PUBLIC_CONTACT_WHATSAPP="910000000000"
