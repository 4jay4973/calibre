# Sanity — copy to .env.local and fill in.
# projectId + dataset are public (they ship in the browser bundle for /studio).
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-01-01"

# Write token — used ONLY by the seed script (scripts/seed.mjs). Keep it secret;
# do not prefix with NEXT_PUBLIC_. Create one in Sanity: API → Tokens (Editor).
SANITY_API_TOKEN=""

# On-demand revalidation webhook secret (server-only, never NEXT_PUBLIC_).
# Set the SAME value here and in the Sanity webhook's "Secret" field so
# /api/revalidate can verify the request signature. Generate a random string,
# e.g. `openssl rand -hex 32`.
SANITY_REVALIDATE_SECRET=""

# --- Contact form: email delivery (Resend) — server-only ---
# Create a key at resend.com and verify a sending domain for CONTACT_FROM.
# Enquiries are emailed to CONTACT_TO (and saved in the Studio, see below);
# contents are never logged. In production the form only reports success if the
# enquiry was emailed OR saved — with neither configured it returns an error.
RESEND_API_KEY=""
CONTACT_TO="hello@calibre-consulting.example"
CONTACT_FROM="Calibre website <enquiries@yourdomain.com>"

# --- Contact form: spam protection (Cloudflare Turnstile) ---
# Site key is public (reaches the browser); secret key is server-only. If unset,
# the human check is skipped in dev — the honeypot still runs.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Contact form: saving enquiries to the Studio (server-only) ---
# Editor token used by /api/contact to save each enquiry as an "Enquiry"
# document (private: id "enquiries.<uuid>"). Create a dedicated token in Sanity
# (API → Tokens → Editor, e.g. "website-enquiries"). Falls back to
# SANITY_API_TOKEN if unset. NEVER prefix with NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN=""

# Public contact details (email, phone, WhatsApp, location) are edited in the
# Studio: Homepage / Site copy → Contact. They are no longer env variables.
